# ========================================================================
# 卒中卫士云端 M5 · 环境变量模板
# 用法: cp .env.example .env 并填写下面所有 CHANGE_THIS / REPLACE_ME
# 生成的 .env 文件严禁提交 git
# ========================================================================

# ---- EMQX Dashboard 管理员密码 (18083 端口, 生产建议改) ----
EMQX_DASHBOARD_PASS=CHANGE_THIS_DASH_PASS

# ---- MQTT 业务账号 (backend 使用, 也可复用给 host_pc 上位机) ----
# 这两个账号需要在 EMQX 启动后手动或用 scripts/init_mqtt_users.sh 创建
MQTT_APP_USER=backend
MQTT_APP_PASS=CHANGE_THIS_MQTT_PASS
MQTT_HOST_USER=device01
MQTT_HOST_PASS=CHANGE_THIS_HOST_PASS

# ---- InfluxDB ----
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASS=CHANGE_THIS_INFLUX_ADMIN
INFLUX_ORG=strokeguard
INFLUX_BUCKET=scores
# 生成长随机串: openssl rand -hex 32
INFLUX_TOKEN=CHANGE_THIS_INFLUX_TOKEN

# ---- 火山引擎 豆包 doubao-1.5-lite ----
# 控制台: https://console.volcengine.com/ark
# 创建 API Key + 推理接入点 endpoint id, 前者填这里
VOLC_ARK_API_KEY=REPLACE_ME_ARK_KEY
# endpoint id 或模型 id
VOLC_ARK_MODEL=REPLACE_ME_ENDPOINT_ID
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- Preliminary external web monitor (optional; leave all three auth values blank to disable login) ----
# Use HTTPS normally. Plain HTTP is permitted only for the preliminary demo with SG_ALLOW_INSECURE_HTTP=1.
# To enable login, set all three values. Example: SG_DEMO_USER=demo-user
# Example: SG_DEMO_PASSWORD=choose-a-strong-password
# Example: SG_DEMO_SESSION_SECRET=generate-a-long-random-secret
SG_DEMO_USER=
SG_DEMO_PASSWORD=
SG_DEMO_SESSION_SECRET=
SG_ALLOW_INSECURE_HTTP=0

# ---- PushPlus WeChat risk alerts (optional, disabled by default) ----
# Configure the message token with scripts/configure_pushplus_interactive.ps1.
PUSHPLUS_ENABLED=0
PUSHPLUS_TOKEN=
PUSHPLUS_DEVICE_NAME=StrokeGuard Mirror 1
